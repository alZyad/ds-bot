# ---- required -------------------------------------------------------------
DISCORD_TOKEN=your-bot-token-here

# ---- recording ------------------------------------------------------------
# How many humans must be in a voice channel before recording starts.
MIN_SPEAKERS=2
# Close the current segment after this many seconds of continuous silence.
SILENCE_TIMEOUT=5.0
# Frames quieter than this RMS (0..32767) count as silence. 0 = trust Discord's
# own voice activity detection only.
SILENCE_RMS=150

# ---- rolling buffer -------------------------------------------------------
# Target amount of *speech* to keep per voice channel, in seconds (3h).
RETENTION_SECONDS=10800
# oldest-chunk | oldest-segment | high-water   (see README)
RETENTION_STRATEGY=oldest-chunk
# Size of one on-disk chunk, in seconds. Also the granularity of deletion.
CHUNK_SECONDS=60
# high-water strategy only: start trimming above RETENTION+HIGH_WATER_SLACK,
# and trim down to RETENTION-LOW_WATER_SLACK.
HIGH_WATER_SLACK=900
LOW_WATER_SLACK=900

# ---- output ---------------------------------------------------------------
DATA_DIR=./data
MP3_BITRATE=64k
FFMPEG=ffmpeg
# Hard cap for a single Discord attachment, in MiB. The real limit of the guild
# is used when it is lower.
MAX_UPLOAD_MB=9.0

# ---- behaviour ------------------------------------------------------------
# Post a "recording started/stopped" notice in the voice channel's chat.
ANNOUNCE=true
# Optional allow/deny lists of voice channel ids (comma separated).
INCLUDE_CHANNEL_IDS=
EXCLUDE_CHANNEL_IDS=
LOG_LEVEL=INFO
