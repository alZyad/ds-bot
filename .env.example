# ---- required -------------------------------------------------------------
DISCORD_TOKEN=your-bot-token-here

# ---- recording ------------------------------------------------------------
# How many humans must be in a voice channel before recording starts.
MIN_SPEAKERS=2
# Close the current segment after this many seconds of continuous silence.
SILENCE_TIMEOUT=5.0
# Frames quieter than this RMS (0..32767) count as silence. Tune it per channel
# at runtime with /rec config; this is only the default.
SILENCE_RMS=150
# Wait this long before leaving a channel that dropped below MIN_SPEAKERS, so a
# reconnect or a channel move does not sever the recording.
LEAVE_GRACE=5.0

# ---- rolling buffer -------------------------------------------------------
# The whole budget, across every channel. The oldest chunk is deleted whenever
# the total exceeds it. 1 GiB is roughly 12 hours of talking.
MAX_DISK_MB=1024
# Size of one on-disk chunk, in seconds. Also the granularity of deletion.
CHUNK_SECONDS=60
# Write an isolated track per speaker while a conversation has no more than
# this many of them. 0 disables isolated tracks entirely.
MAX_SPEAKER_TRACKS=6

# ---- output ---------------------------------------------------------------
DATA_DIR=./data
# AAC bitrate for both the mix and the isolated tracks.
AUDIO_BITRATE=64k
FFMPEG=ffmpeg
# Hard cap for a single Discord attachment, in MiB. The real limit of the guild
# is used when it is lower.
MAX_UPLOAD_MB=9.0
# Export emits one file per conversation. Conversations closer together than
# this many seconds are merged into a single file.
MERGE_GAP_SECONDS=120

# ---- behaviour ------------------------------------------------------------
# Post a "recording started/stopped" notice in the voice channel's chat.
ANNOUNCE=true
# Optional allow/deny lists of voice channel ids (comma separated).
INCLUDE_CHANNEL_IDS=
EXCLUDE_CHANNEL_IDS=
LOG_LEVEL=INFO
