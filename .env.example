# ---- required -------------------------------------------------------------
DISCORD_TOKEN=your-bot-token-here

# ---- links ----------------------------------------------------------------
# Base URL of the links handed out in Discord; the bot serves them on WEB_PORT.
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# Time zone of the session picker labels and downloaded file names.
TIMEZONE=Europe/Paris

# ---- recording ------------------------------------------------------------
# How many humans must be in a voice channel, one of them opted in with
# /record-me, before recording starts.
MIN_SPEAKERS=2
# Close the current segment after this many seconds of continuous silence.
SILENCE_TIMEOUT=5.0
# Frames quieter than this RMS (0..32767) count as silence.
SILENCE_RMS=150
# Wait this long before leaving a channel that stopped qualifying, so a
# reconnect or a channel move does not sever the recording.
LEAVE_GRACE=5.0

# ---- storage --------------------------------------------------------------
# The whole budget, across every server. The oldest session is deleted whenever
# the total exceeds it.
MAX_DISK_MB=10240
# Size of one on-disk chunk, in seconds.
CHUNK_SECONDS=60
# Leaving voice for longer than this ends the session; rejoining sooner, or
# moving channel, continues it.
SESSION_GAP_SECONDS=300
# Write an isolated track per speaker while a conversation has no more than
# this many of them. 0 disables isolated tracks.
MAX_SPEAKER_TRACKS=6

# ---- output ---------------------------------------------------------------
DATA_DIR=./data
# AAC bitrate for both the mix and the isolated tracks.
AUDIO_BITRATE=64k
FFMPEG=ffmpeg

# ---- behaviour ------------------------------------------------------------
# Post who is recorded when joining, newcomers, and a link when leaving, in the
# voice channel's chat.
ANNOUNCE=true
# Optional allow/deny lists of voice channel ids (comma separated).
INCLUDE_CHANNEL_IDS=
EXCLUDE_CHANNEL_IDS=
LOG_LEVEL=INFO
